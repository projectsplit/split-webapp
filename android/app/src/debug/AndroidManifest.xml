<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the debug variant only. Kept as its own manifest rather than a flag on the main one so
  that release builds cannot inherit the cleartext exception by accident.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
